# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
DATABASE_NAME=data_retrieval_system

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Cache Configuration
CACHE_TTL=3600
CACHE_ENABLED=false

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=5000

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0

# API Keys for Connectors
# Get your USDA NASS API key from: https://quickstats.nass.usda.gov/api
USDA_NASS_API_KEY=your_usda_nass_api_key_here

# Get your Census API key from: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# Get your FBI Crime API key from: https://crime-data-explorer.fr.cloud.gov/pages/docApi
FBI_CRIME_API_KEY=your_fbi_crime_api_key_here
