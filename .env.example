# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster
DATABASE_NAME=data_retrieval_system

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=3600
CACHE_ENABLED=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0

# LangGraph Discovery Workflow Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
DISCOVERY_LLM_MODEL=claude-sonnet-4-20250514
DISCOVERY_MAX_SEARCH_RESULTS=10
DISCOVERY_TEST_RETRIES=3
DISCOVERY_TEST_BACKOFF=2.0
DISCOVERY_REQUEST_TIMEOUT=30

# API Key Gathering Configuration
ARCADE_API_KEY=your_arcade_api_key_here
DISCOVERY_EMAIL=discovery@yourdomain.com
ARCADE_USER_ID=
API_KEY_CHECK_INTERVAL=30
API_KEY_CHECK_MAX_ATTEMPTS=20

# CRITICAL: API Key Encryption Key
# This key is used to encrypt API keys stored in MongoDB.
# WARNING: If you change this key, previously encrypted API keys will become unreadable.
# Generate a new key with: python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Then copy the generated key and set it here:
API_KEY_ENCRYPTION_KEY=your_generated_encryption_key_here
